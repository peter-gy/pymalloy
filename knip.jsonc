{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreBinaries": ["uv"],
  "workspaces": {
    "scripts": { "entry": ["*.ts"] },
    "packages/duckdb": { "entry": ["src/index.ts", "src/arrow.ts"] },
    "packages/core": {
      "entry": ["src/index.ts", "src/tooling.ts", "src/jobs.ts", "src/adapters.ts"],
    },
    "packages/widget": { "ignoreDependencies": ["process"] },
    "packages/protocol": { "entry": ["src/records.ts"] },
    "apps/e2e": {
      "entry": ["pyodide/resolve.mjs"],
      "vite": { "config": "standalone/vite.config.ts" },
    },
    "packages/browser": {
      // process is injected by the bundler. DuckDB-WASM declarations reference Emscripten globals.
      "ignoreDependencies": ["process", "@types/emscripten"],
    },
    "packages/python": {
      "entry": ["rust/bootstrap.js"],
      // The build command delegates to scripts. Workspace dependencies supply staged assets.
      "ignoreDependencies": [
        "@pymalloy/scripts",
        "@pymalloy/compiler",
        "@pymalloy/pyodide",
        "@pymalloy/widget",
      ],
    },
    "packages/pyodide": { "ignoreDependencies": ["process"] },
  },
}
