{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreBinaries": ["uv"],
  "workspaces": {
    "scripts": { "entry": ["*.ts"] },
    "packages/duckdb": { "entry": ["src/index.ts", "src/arrow.ts"] },
    "packages/core": { "entry": ["src/index.ts", "src/tooling.ts", "src/types.ts"] },
    "packages/widget": { "ignoreDependencies": ["process"] },
    "packages/protocol": { "entry": ["src/records.ts"] },
    "apps/e2e": {
      "vite": { "config": "standalone/vite.config.ts" },
    },
    "packages/browser": {
      // process is injected by the bundler; DuckDB-WASM declarations reference Emscripten globals.
      "ignoreDependencies": ["process", "@types/emscripten"],
    },
    "packages/python": {
      // The build command delegates to scripts; headless and widget supply its staged assets.
      "ignoreDependencies": ["@pymalloy/scripts", "@pymalloy/headless", "@pymalloy/widget"],
    },
  },
}
