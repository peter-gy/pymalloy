{
  "name": "pymalloy-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "vp check && pnpm -r run typecheck && pnpm check:knip",
    "check:knip": "knip --treat-config-hints-as-errors",
    "test": "pnpm --filter @malloy-runtime/compiler --filter @malloy-runtime/node --filter @malloy-runtime/duckdb --filter @pymalloy/widget --filter @pymalloy/headless test",
    "docs:dev": "pnpm --filter @pymalloy/docs dev",
    "docs:build": "pnpm --filter @pymalloy/docs build",
    "docs:preview": "pnpm --filter @pymalloy/docs preview",
    "format": "vp fmt",
    "e2e": "pnpm --filter @pymalloy/e2e test",
    "canary": "node tools/consumer-canary.mjs",
    "records": "uv run python tools/generate-records.py",
    "bench:compiler": "node tools/benchmark_compiler.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "ts-json-schema-generator": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.10.0"
}
